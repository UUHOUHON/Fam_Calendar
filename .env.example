DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-string"
APP_BASE_URL="https://fam-calendar-eight.vercel.app"
NEXT_PUBLIC_APP_URL="https://fam-calendar-eight.vercel.app"

# Preferred: Brevo API key (Settings → SMTP & API → API keys)
# Starts with xkeysib- ...
BREVO_API_KEY="xkeysib-xxxxxxxx"
SMTP_FROM="The Family Calendar <your-verified-sender@example.com>"

# Or SMTP (Login is often xxx@smtp-brevo.com — NOT your Gmail)
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="123456@smtp-brevo.com"
# SMTP_PASS="your-brevo-smtp-key"
# SMTP_SECURE=false
